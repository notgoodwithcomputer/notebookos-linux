# /etc/inittab — Notebook OS (overrides the Buildroot-generated one)
#
# Format: <id>::<action>:<process>
# id == the tty to run on (busybox init)
#
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
# securityfs, after `mount -a` has put sysfs under /sys. The kernel is locked
# down from its own configuration whether or not this is mounted — enforcement
# is in the LSM, not in the file — but /sys/kernel/security/lockdown is the
# only way to ASK a running machine what state it is in, and a hardening
# campaign that cannot be checked on the machine it hardened is a claim rather
# than a measurement (docs/APP-TRUST.md L0). Reads `none [integrity]
# confidentiality`; the file can only ever be written to raise the level.
::sysinit:/bin/mkdir -p /sys/kernel/security
::sysinit:/bin/mount -t securityfs none /sys/kernel/security
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/etc/init.d/rcS

# Put a getty on the serial port
# NO GETTY ON tty1. X owns tty1, and the getty that was here read
#     tty1::respawn:/sbin/getty -n -l /bin/sh 38400 tty1
# where -n means NO LOGIN PROMPT and -l /bin/sh means the login program
# IS a shell. Ctrl+Alt+F1, or X crashing, dropped straight to an
# UNAUTHENTICATED ROOT SHELL. That defeated the sign-in screen entirely,
# and with USB HID enabled it was not even a physical-access attack: a
# device that looks like a memory stick can send Ctrl+Alt+F1 and type as
# root in seconds. S99notebookos starts the desktop via xinit; no getty
# is needed here at all.

# Debug shell on the second serial port (qemu -serial unix:...ttyS1.sock).
# Root, no login — this is a development image on an offline machine.
# Serial debug shell, ONLY when the kernel command line contains
# "nbdebug". A development image asks for it; a shipped one never does,
# so an attached serial cable is not a free root shell.
ttyS1::respawn:/opt/notebook/debugshell.sh

