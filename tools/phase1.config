# Seed for the no-internet kernel: everything not listed here goes to =n.
#   make -C linux O=../kbuild KCONFIG_ALLCONFIG=../tools/phase1.config allnoconfig
# Tiny on purpose: fast rebuilds are the tool that makes the purge tractable.

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-nointernet"
# CONFIG_WERROR is not set

# console + boot basics
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_KALLSYMS=y

# CONFIG_NET stays only for the local-only families (AF_NETLINK — udev's
# uevent socket). No socket family reaches off the machine: AF_INET and its
# kin are gone, and Bluetooth — the last one that did — was removed 2026-08
# (attack-surface reduction; see tools/desktop.config and docs/SECURITY-MODEL.md).
CONFIG_NET=y
# CONFIG_BT is not set

# explicitly dead even before the source purge
# CONFIG_INET is not set
# CONFIG_UNIX is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
# CONFIG_ETHTOOL_NETLINK is not set
